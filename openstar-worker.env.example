OPENSTAR_COORDINATOR_URL=https://coordinator.example/
# Optional stable UUID. If omitted, one is stored under OPENSTAR_STATE_DIR.
# OPENSTAR_NODE_ID=00000000-0000-4000-8000-000000000000
OPENSTAR_STATE_DIR=/var/lib/openstar-worker
OPENSTAR_WORK_CONCURRENCY=1
OPENSTAR_CPU_THREADS=4
OPENSTAR_POLL_INTERVAL_MS=2000
OPENSTAR_MAX_BACKOFF_MS=30000
OPENSTAR_REQUEST_TIMEOUT_SECS=30
OPENSTAR_LOG=info
